# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Persistent Neon Postgres database
DATABASE_URL=

# Optional local/self-hosted SQLite path. On Vercel, the legacy SQLite routes
# fall back to ephemeral /tmp storage when this is unset.
AVIATION_WIKI_DB_PATH=

# Transactional notification email (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Search engine ownership and instant indexing
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# Protects scheduled maintenance and notification endpoints
CRON_SECRET=
